{
  "name": "hamarasafar",
  "version": "1.0.0",
  "description": "Hamara Safar - AI-Powered Trip Planner with Gemini AI, Firebase & Real-time Hotel Search",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "local:container": "node local-container.js",
    "docker:build": "docker build -t hamarasafar:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.docker hamarasafar:latest",
    "docker:compose": "docker-compose up --build",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.14.0",
    "serpapi": "^2.2.1"
  }
}
