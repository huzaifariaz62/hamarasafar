# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# SerpAPI Key (used for Google Hotels & Google Images searches)
SERPAPI_API_KEY=your_serpapi_api_key_here

# RapidAPI Airbnb Key (Optional fallback)
RAPIDAPI_KEY=your_rapidapi_key_here

# Backend Server Port
PORT=3000

# Firebase Configuration (required for live authentication & DB syncing)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_URL=
